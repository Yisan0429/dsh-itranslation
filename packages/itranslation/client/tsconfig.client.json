{
  // Client face of the split client package: the browser bundle sources and
  // the CSS Module declarations. Browser purity (`types: []`, DOM lib).
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo"
  },
  "include": [
    "src/client/**/*",
    "src/css-modules.d.ts"
  ]
}
