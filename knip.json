{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs"
      ],
      "project": [
        "scripts/**/*.mjs"
      ]
    },
    "packages/*/*": {
      "entry": [
        "tests/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "packages/itranslation/client": {
      "ignoreDependencies": [
        // lightningcss is consumed only by the shared clientBundle preset
        // (imported read-only from ~/deepseek-harness, D66), never by this
        // repo's own source.
        "lightningcss"
      ]
    }
  }
}
