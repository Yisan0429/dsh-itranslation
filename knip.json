{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs"
      ],
      "project": [
        "scripts/**/*.mjs"
      ]
    },
    "packages/*/*": {
      "entry": [
        "tests/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "packages/itranslation/client": {
      "ignoreIssues": {
        "tsdown.preset.ts": [
          "exports"
        ]
      }
    }
  },
  "ignoreBinaries": [
    "dsh"
  ],
  "ignoreWorkspaces": [
    "packages/itranslation/bundle"
  ]
}
