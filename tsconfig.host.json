{
  // Host aggregate (one of the two check units; see tsconfig.json). Client
  // package sources type-check inside tsconfig.client.json; both programs see
  // every package through explicit project references.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "packages/*/*/tests/**/*.ts"
  ],
  "exclude": [
    // Browser specs of the client package type-check in tsconfig.client.json;
    // its host-face specs (web-settings, host-entry) stay in this aggregate.
    "packages/itranslation/client/tests/**/*.client.spec.ts"
  ],
  "references": [
    { "path": "./packages/itranslation/core" },
    { "path": "./packages/itranslation/tools" },
    { "path": "./packages/itranslation/client/tsconfig.host.json" }
  ]
}
