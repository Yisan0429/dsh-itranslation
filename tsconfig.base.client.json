{
  // Client-side compiler shape shared by tsconfig.client.json and the client
  // package: browser library API, React JSX, no ambient node types.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": []
  }
}
